# Root gitignore to handle both web (Next.js) and mobile (React Native/Expo)

# Dependency directories
node_modules/
jspm_packages/
web-build/

# Next.js build output
web/.next/
web/out/

# Expo / React Native build artifacts
mobile/.expo/
mobile/dist/
mobile/android/
mobile/ios/
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
web/.env*.local
mobile/.env*.local

# System Files
.DS_Store
Thumbs.db
